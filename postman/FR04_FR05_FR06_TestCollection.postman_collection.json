							"mode": "raw",
							"raw": "{\n    \"username\": \"{{studentUsername}}\",\n    \"password\": \"Student@123\",\n    \"email\": \"{{dynamicEmail}}\",\n    \"fullName\": \"Nguyễn Văn Test\"\n}"
