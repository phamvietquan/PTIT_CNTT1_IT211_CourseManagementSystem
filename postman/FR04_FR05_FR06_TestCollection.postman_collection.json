				{
					"name": "TC09 - Đăng ký khóa học đã đầy (maxStudents)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Tạo khóa học với maxStudents = 1 và fill bằng 1 student khác",
									"var baseUrl = pm.collectionVariables.get('baseUrl');",
									"var adminToken = pm.collectionVariables.get('adminToken');",
									"var lecturerId = pm.collectionVariables.get('lecturerUserId');",
									"var timestamp = Date.now();",
									"",
									"// Step 1: Tạo khóa học maxStudents = 1",
									"pm.sendRequest({",
									"    url: baseUrl + '/api/v1/admin/courses',",
									"    method: 'POST',",
									"    header: {",
									"        'Content-Type': 'application/json',",
									"        'Authorization': 'Bearer ' + adminToken",
									"    },",
									"    body: {",
									"        mode: 'raw',",
									"        raw: JSON.stringify({",
									"            courseCode: 'FUL' + timestamp.toString().slice(-6),",
									"            courseName: 'Khóa học Full Test',",
									"            description: 'Test khóa học đã đầy',",
									"            maxStudents: 1,",
									"            lecturerId: parseInt(lecturerId)",
									"        })",
									"    }",
									"}, function (err, res) {",
									"    var fullCourseId = res.json().data.id;",
									"    pm.variables.set('fullCourseId', fullCourseId);",
									"    ",
									"    // Step 2: Register a filler student",
									"    pm.sendRequest({",
									"        url: baseUrl + '/api/auth/register',",
									"        method: 'POST',",
									"        header: { 'Content-Type': 'application/json' },",
									"        body: {",
									"            mode: 'raw',",
									"            raw: JSON.stringify({",
									"                username: 'filler_' + timestamp,",
									"                password: 'Filler@123',",
									"                email: 'filler_' + timestamp + '@ptit.edu.vn',",
									"                fullName: 'Filler Student'",
									"            })",
									"        }",
									"    }, function (err2, res2) {",
									"        // Step 3: Login as filler student",
									"        pm.sendRequest({",
									"            url: baseUrl + '/api/auth/login',",
									"            method: 'POST',",
									"            header: { 'Content-Type': 'application/json' },",
									"            body: {",
									"                mode: 'raw',",
									"                raw: JSON.stringify({",
									"                    username: 'filler_' + timestamp,",
									"                    password: 'Filler@123'",
									"                })",
									"            }",
									"        }, function (err3, res3) {",
									"            var fillerToken = res3.json().data.accessToken;",
									"            // Step 4: Enroll filler student to fill the course",
									"            pm.sendRequest({",
									"                url: baseUrl + '/api/v1/student/enrollments',",
									"                method: 'POST',",
									"                header: {",
									"                    'Content-Type': 'application/json',",
									"                    'Authorization': 'Bearer ' + fillerToken",
									"                },",
									"                body: {",
									"                    mode: 'raw',",
									"                    raw: JSON.stringify({ courseId: fullCourseId })",
									"                }",
									"            }, function (err4, res4) {",
									"                console.log('Khóa học đã đầy: ' + fullCourseId);",
