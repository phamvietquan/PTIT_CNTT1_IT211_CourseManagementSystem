		{
			"name": "FR-05: Quản lý Người dùng & Lớp học - Admin (5 tests)",
			"item": [
				{
					"name": "TC01 - Admin tạo người dùng mới (LECTURER)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var timestamp = Date.now();",
									"pm.variables.set('newLecturerUsername', 'lecturer_' + timestamp);",
									"pm.variables.set('newLecturerEmail', 'lecturer_' + timestamp + '@ptit.edu.vn');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('FR05-TC01: Tạo user LECTURER thành công - Status 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('FR05-TC01: Thông tin user trả về đúng', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.role).to.eql('LECTURER');",
									"    pm.expect(jsonData.data.active).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.collectionVariables.set('lecturerUserId', jsonData.data.id);",
									"    pm.collectionVariables.set('createdUserId', jsonData.data.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{newLecturerUsername}}\",\n    \"password\": \"Lecturer@123\",\n    \"email\": \"{{newLecturerEmail}}\",\n    \"fullName\": \"Giảng viên Test FR05\",\n    \"role\": \"LECTURER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/users",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "users"]
						}
					}
				},
				{
					"name": "TC02 - Admin lấy danh sách users (phân trang + tìm kiếm)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('FR05-TC02: Lấy danh sách users thành công - Status 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('FR05-TC02: Response có cấu trúc phân trang đúng', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property('content');",
									"    pm.expect(jsonData.data).to.have.property('page');",
									"    pm.expect(jsonData.data).to.have.property('size');",
									"    pm.expect(jsonData.data).to.have.property('totalElements');",
									"    pm.expect(jsonData.data).to.have.property('totalPages');",
									"    pm.expect(jsonData.data).to.have.property('last');",
									"    pm.expect(jsonData.data.content).to.be.an('array');",
									"    pm.expect(jsonData.data.size).to.eql(5);",
									"    pm.expect(jsonData.data.page).to.eql(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
