					"name": "TC01 - Đăng ký thành công với thông tin hợp lệ",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var timestamp = Date.now();",
									"pm.collectionVariables.set('studentUsername', 'student_test_' + timestamp);",
									"pm.variables.set('dynamicEmail', 'student_test_' + timestamp + '@ptit.edu.vn');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('FR04-TC01: Đăng ký sinh viên thành công - Status 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('FR04-TC01: Response body chứa thông tin user', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.message).to.include('thành công');",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data).to.have.property('username');",
									"    pm.expect(jsonData.data).to.have.property('email');",
									"    pm.expect(jsonData.data).to.have.property('fullName');",
									"    pm.expect(jsonData.data.role).to.eql('STUDENT');",
									"    pm.expect(jsonData.data.active).to.be.true;",
									"    pm.collectionVariables.set('studentUserId', jsonData.data.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
